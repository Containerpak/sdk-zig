{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Zig SDK",
  "description": "Zig compiler and standard library.",
  "version": "0.16.0",
  "image": "ghcr.io/containerpak/sdk-zig@sha256:d1bde6f476c13e5e4888b865d6f5adf35b0dcd1f119e141f2c340d917d736aa8",
  "binaries": [
    "/usr/local/bin/zig"
  ],
  "desktop_entries": [],
  "dependencies": [],
  "addons": [],
  "addon_provider": {
    "id": "zig",
    "slot": "sdk.zig",
    "mode": "exclusive",
    "exports": {
      "path": [
        "/opt/zig"
      ]
    }
  },
  "idle_time": 0,
  "override": {
    "displayX11": false,
    "socketWayland": false,
    "socketPulseAudio": false,
    "socketSshAgent": true,
    "socketCups": false,
    "socketGpgAgent": true,
    "bluetooth": false,
    "deviceDri": false,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": false,
    "openURI": false,
    "hostApplications": false,
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "env": [],
    "network": true,
    "hostNetwork": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
